{
  "name": "arlo-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "lint": "eslint --cache --ext ts --ext tsx src",
    "lint:fix": "pnpm lint --fix",
    "start": "vite",
    "test": "is-ci \"test:ci\" \"test:watch\"",
    "test:ci": "CI=true tsc && vitest --maxWorkers 4 --coverage --testTimeout 30000",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest watch"
  },
  "dependencies": {
    "@blueprintjs/core": "^3.20.0",
    "@blueprintjs/icons": "^3.12.0",
    "@blueprintjs/select": "^3.19.1",
    "@hookform/error-message": "^2.0.0",
    "@sentry/react": "^5.27.3",
    "@sentry/tracing": "^5.27.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "classnames": "^2.3.2",
    "copy-to-clipboard": "^3.3.1",
    "d3-geo": "^3.1.1",
    "fast-deep-equal": "^3.1.3",
    "formik": "^2.2.0",
    "history": "^4.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^3.5.23",
    "normalize.css": "^8.0.1",
    "qrcode.react": "^0.9.3",
    "react": "16.13.1",
    "react-app-polyfill": "^1.0.6",
    "react-dom": "^16.13.1",
    "react-hook-form": "^6.13.1",
    "react-query": "^3.39.0",
    "react-router-dom": "^5.1.2",
    "react-table": "^7.1.0",
    "react-toastify": "^5.3.1",
    "styled-components": "^4.3.2",
    "topojson-client": "^3.1.0",
    "uuidv4": "^4.0.0",
    "vite": "^7.3.5",
    "yup": "^0.27.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@sinonjs/fake-timers": "^6.0.1",
    "@testing-library/cypress": "^7.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.4",
    "@testing-library/react-hooks": "^3.3.0",
    "@testing-library/user-event": "^12.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/history": "^4.7.5",
    "@types/node": "26.6.5",
    "@types/qrcode.react": "^0.8.2",
    "@types/react": "16.9.0",
    "@types/react-dom": "16.9.8",
    "@types/react-router-dom": "^5.1.3",
    "@types/react-table": "^7.7.1",
    "@types/styled-components": "^5.1.2",
    "@types/testing-library__react-hooks": "^3.2.0",
    "@types/topojson-client": "^3.1.0",
    "@types/topojson-specification": "^1.0.1",
    "@types/uuidv4": "^2.0.0",
    "@types/yup": "^0.26.22",
    "@typescript-eslint/eslint-plugin": "^3.0.1",
    "@typescript-eslint/parser": "^3.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-preset-react-app": "^9.1.1",
    "camelcase": "^5.3.1",
    "cypress": "^11.0.0",
    "cypress-file-upload": "^4.1.1",
    "eslint": "^6.6.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.2.0",
    "eslint-plugin-cypress": "^2.2.1",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-react": "^7.13.0",
    "eslint-plugin-react-hooks": "^1.6.1",
    "eslint-plugin-testing-library": "^3.1.3",
    "identity-obj-proxy": "3.0.0",
    "is-ci-cli": "^1.1.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "maildev": "^2.1.0",
    "pdf-parse": "^1.1.1",
    "pdf-visual-diff": "^0.5.0",
    "react-test-renderer": "^16.13.1",
    "stylelint": "^10.0.1",
    "stylelint-config-palantir": "^4.0.0",
    "stylelint-config-prettier": "^5.1.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^0.3.3"
  },
  "lint-staged": {
    "*.+(css|graphql|json|less|md|mdx|sass|scss|yaml|yml)": [
      "oxfmt --no-error-on-unmatched-pattern --write"
    ],
    "*.+(js|jsx|ts|tsx)": [
      "oxfmt --no-error-on-unmatched-pattern --write",
      "stylelint",
      "eslint --cache --fix"
    ],
    "*.+(ts|tsx)": [
      "bash -c tsc"
    ],
    "*.css": [
      "stylelint --config .stylelintrc-css.js --fix"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
