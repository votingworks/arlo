{
  "name": "arlo",
  "private": true,
  "scripts": {
    "build": "yarn --cwd client install && yarn --cwd client build",
    "heroku-postbuild": "yarn build",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.+(css|graphql|json|less|md|mdx|sass|scss|yaml|yml)": [
      "prettier --write"
    ],
    "*.py": [
      "uv run ruff format",
      "uv run ruff check",
      "./scripts/run-ty.sh"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "husky": "^7.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^1.19.1",
    "sort-package-json": "^3.7.1"
  },
  "engines": {
    "node": "26.12.0"
  }
}
