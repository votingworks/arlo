{
  "name": "arlo",
  "private": true,
  "scripts": {
    "build": "pnpm --dir client build",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "heroku-postbuild": "pnpm build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^7.0.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.72.0"
  },
  "lint-staged": {
    "*.+(css|graphql|js|json|jsx|less|md|mdx|sass|scss|ts|tsx|yaml|yml)": [
      "oxfmt --no-error-on-unmatched-pattern --write"
    ],
    "*.py": [
      "uv run ruff format",
      "uv run ruff check",
      "./scripts/run-ty.sh"
    ]
  },
  "engines": {
    "node": "26.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
